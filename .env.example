# Copy to .env.local and fill in. All are optional; the site works without them.

# Google Analytics 4 measurement ID (enables GA4 + Consent Mode v2 + consent banner).
# Set in Cloudflare Pages for production. Example: G-LE4CW6Z6VZ
NEXT_PUBLIC_GA_ID=

# Cloudflare Web Analytics is auto-injected by Cloudflare Pages — no env var needed.

# Google AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX (enables ad slots)
NEXT_PUBLIC_ADSENSE_ID=

# Web3Forms access key for the contact form (https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_KEY=
