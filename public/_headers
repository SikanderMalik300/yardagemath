# Cloudflare Pages security & hygiene headers (build-spec A3).
# Add a Content-Security-Policy here once the ad scripts are known.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  Cache-Control: public, max-age=0, must-revalidate

# Long cache only for content-hashed assets and versioned brand files
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the *.pages.dev preview copy out of search indexes (only the apex domain should rank)
https://yardagemath.pages.dev/*
  X-Robots-Tag: noindex
